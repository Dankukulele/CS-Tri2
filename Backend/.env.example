PORT=3000
BASE_URL=http://localhost:3000

# Maximum accepted JSON and form request sizes.
JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=50kb

MONGO_URI=
JWT_SECRET=

# Trusted DiscountMate frontend origins.
# Separate multiple origins with commas and do not add trailing slashes.
CORS_ORIGIN=http://localhost:8081

ML_SERVICE_URL=http://localhost:5001
REVERSE_IMAGE_SEARCH_SERVICE_URL=http://localhost:8001
ANALYTICS_SERVICE_URL=http://localhost:5002

SUPPORT_EMAIL=supportdiscountmate@gmail.com
SUPPORT_EMAIL_USER=supportdiscountmate@gmail.com
SUPPORT_EMAIL_APP_PASSWORD=

RIS_STARTUP_TIMEOUT_MS=300000

# Google Cloud / FAISS reverse image search
# Fill this with your DiscountMate GCP project ID for local Google Cloud access.
GOOGLE_CLOUD_PROJECT=sit-26t1-discountmate-935cb94
MONGO_URI_SECRET_NAME=mongo-uri
JWT_SECRET_SECRET_NAME=jwt-secret
OPEN_ROUTER_API_KEY_SECRET_NAME=open-router-api-key
HUGGING_FACE_TOKEN_SECRET_NAME=hugging-face-token

FAISS_GCP_PROJECT=sit-26t1-discountmate-935cb94
FAISS_BUCKET_NAME=discountmate-ml-models
FAISS_OBJECT_NAME=reverse_image_search.faiss

OPEN_ROUTER_API=

# Hugging Face API token for sentence-transformers access.
HUGGING_FACE_TOKEN=

RAG_BUCKET_NAME=discountmate-ml-models
RAG_OBJECT_PREFIX=recipe_rag/